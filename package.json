{
  "name": "magic-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Magic.AI - AI Coding Assistant",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.magicai.app",
    "productName": "Magic.AI",
    "directories": { "output": "dist-electron" },
    "files": ["electron/**/*"],
    "win": {
      "target": "portable",
      "icon": "electron/icon.png"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.441.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
