# Forge Studio — AI Website Builder
#
# Copy this file to `.env.local` and add your key to enable the AI Agent.
# The key is only ever used server-side. It is never exposed to the browser
# and is never included in exported project ZIP files.

# Google Gemini API key (required for the AI Agent chat / file edits)
GEMINI_API_KEY=

# Optional: choose a Gemini model (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------
# Personal wrapper (/wrap) — a private coding assistant that runs
# the opencode CLI on the server. Needs the opencode CLI installed.
# Set WRAP_ENABLED=true to switch the /wrap page + API on.
# WRAP_ENABLED=true

# Optional shared secret. If set, the /wrap API requires the matching
# key in the x-wrap-key header (entered once in the /wrap page).
# WRAP_KEY=

# Optional default model for opencode run, e.g. openai/gpt-5-codex.
# Can also be overridden per request from the /wrap page.
# WRAP_MODEL=

# Model credentials: the wrapper inherits standard provider keys from
# the server environment, so GEMINI_API_KEY above also works, and you
# can add others, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
